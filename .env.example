GROQ_API_KEY=your_groq_api_key_here
PORT=5000

# Admin page at /admin (leave ADMIN_PASSWORD empty to keep the admin area switched off).
# Use a long, unique password (12+ characters).
ADMIN_PASSWORD=
# Postgres connection string, e.g. from neon.tech. Without it stats go to a local file that is
# lost when the host redeploys.
DATABASE_URL=
# Optional: how many days of stats to keep (default 90)
# METRICS_RETENTION_DAYS=90
